generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────

enum OrgRole {
  ADMIN
  OPERATOR
  READ_ONLY
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BaselineStatus {
  DRAFT
  RELEASED
  COUNTERED
  CONFIRMED
  LOCKED
  SUPERSEDED
}

enum ClauseType {
  PRICING
  TIMELINE
  SCOPE
  QUALITY
  REGULATORY
  PAYMENT_TERMS
  IP
  OTHER
}

enum ChangeStatus {
  DRAFT
  RELEASED
  COUNTERED
  CONFIRMED
  LOGGED
}

enum ChangeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeReasonCode {
  SPONSOR_REQUEST
  VENDOR_ERROR
  MATERIAL_DELAY
  REGULATORY_REQUIREMENT
  OTHER
}

enum ConfirmationMode {
  BILATERAL
  SHADOW
}

enum InvoiceStatus {
  UPLOADED
  MAPPED
  FLAGGED
  APPROVED
  DISPUTED
}

enum LineItemFlag {
  NONE
  RATE_MISMATCH
  SCOPE_CREEP
  UNAPPROVED_CHANGE
  DUPLICATE
  MISSING_BASELINE
  OTHER
}

enum EvidenceType {
  INVOICE
  SOW_MSA
  EMAIL_APPROVAL
  TRANSCRIPT
  CHANGE_ORDER
  DISPUTE_PACKET
  EXPORT_PACK
  OTHER
}

enum EventAction {
  // Auth
  USER_LOGIN
  USER_LOGOUT
  // Program
  PROGRAM_CREATED
  PROGRAM_UPDATED
  PROGRAM_ARCHIVED
  // Baseline
  BASELINE_CREATED
  BASELINE_RELEASED
  BASELINE_CONFIRMED
  BASELINE_COUNTERED
  BASELINE_LOCKED
  BASELINE_SUPERSEDED
  CLAUSE_CREATED
  CLAUSE_UPDATED
  CLAUSE_DELETED
  // Change
  CHANGE_DRAFTED
  CHANGE_RELEASED
  CHANGE_CONFIRMED
  CHANGE_COUNTERED
  CHANGE_AUTO_LOGGED
  // Invoice
  INVOICE_UPLOADED
  INVOICE_MAPPED
  INVOICE_FLAGGED
  INVOICE_APPROVED
  INVOICE_DISPUTED
  LINE_ITEM_FLAGGED
  // Evidence
  EVIDENCE_UPLOADED
  EVIDENCE_FINALIZED
  // Magic Link
  MAGIC_LINK_CREATED
  MAGIC_LINK_VIEWED
  MAGIC_LINK_CONFIRMED
  MAGIC_LINK_EXPIRED
  // Export
  EXPORT_GENERATED
  // Retention
  RETENTION_DELETE_EXECUTED
  // Extraction
  EXTRACTION_JOB_CREATED
  EXTRACTION_JOB_SUCCEEDED
  EXTRACTION_JOB_FAILED
  EXTRACTION_JOB_APPLIED
  // Commitment Terms
  TERM_CREATED
  TERM_UPDATED
  TERM_IMPORTED
  // Evidence backloading
  EVIDENCE_BACKLOADED
  // CSV/Excel bulk import
  BULK_IMPORT
  // Email
  EMAIL_SENT
  EMAIL_DELIVERED
  EMAIL_OPENED
  EMAIL_BOUNCED
  EMAIL_FAILED
  // Dispute delivery
  DISPUTE_PACK_SENT
  // Payment reminders
  PAYMENT_REMINDER_SENT
  REMINDER_SCHEDULE_CREATED
  REMINDER_SCHEDULE_PAUSED
  REMINDER_SCHEDULE_RESUMED
}

enum MagicLinkScope {
  BASELINE_CONFIRM
  CHANGE_CONFIRM
}

enum ExportType {
  BASELINE_PACK
  CHANGE_LEDGER_PACK
  INVOICE_REVIEW_PACK
  DISPUTE_PACKET
  WEEKLY_GOVERNANCE_PACK
}

enum ExtractionJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExtractionTargetType {
  BASELINE
  INVOICE
  CHANGE_ORDER
  CHANGE_TRANSCRIPT
  CHANGE_EMAIL
  TERMS
}

enum ImportTargetType {
  INVOICE
  BASELINE
  CONTRACT
}

enum ContactType {
  CLIENT
  INTERNAL
  OTHER
}

enum TermType {
  RESERVATION_FEE
  COMMITMENT_DATE
  PAYMENT_MILESTONE
  CANCELLATION_WINDOW
  PENALTY_RULE
  MATERIAL_ORDER_TRIGGER
}

enum EmailTemplateType {
  CONFIRMATION_REQUEST
  PAYMENT_REMINDER
  DISPUTE_DELIVERY
  FOLLOW_UP_REMINDER
  CUSTOM
}

enum EmailEntityType {
  BASELINE
  CHANGE
  INVOICE
  DISPUTE
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  BOUNCED
  FAILED
}

// ─── Core Models ────────────────────────────────────────────

/// Maps to Supabase auth.users — stores app-level profile data.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships      OrgMember[]
  eventLogs        EventLog[]
  magicLinks       MagicLink[]   @relation("CreatedByUser")
  assignedPrograms Program[]     @relation("AssignedPrograms")
  sentEmails       EmailLog[]    @relation("SentEmails")

  @@map("users")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members            OrgMember[]
  programs           Program[]
  logoUrl            String?          @map("logo_url")
  importMappings     ImportMapping[]
  emailLogs          EmailLog[]
  emailConfig        OrgEmailConfig?
  reminderSchedules  ReminderSchedule[]
  contacts           ProgramContact[]

  @@map("organizations")
}

model OrgMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole  @default(OPERATOR)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

model Program {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  name            String
  cdmoName        String        @map("cdmo_name")
  molecule        String?
  modality        String?
  description     String?
  status          ProgramStatus @default(DRAFT)
  currency        String        @default("USD")
  retentionDays   Int?          @map("retention_days")
  activatedAt     DateTime?     @map("activated_at")
  changeThreshold Decimal?      @map("change_threshold") @db.Decimal(14, 2)
  assignedPmId    String?       @map("assigned_pm_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  org              Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedPm       User?            @relation("AssignedPrograms", fields: [assignedPmId], references: [id])
  baselines        Baseline[]
  changes          Change[]
  invoices         Invoice[]
  evidences        Evidence[]
  eventLogs        EventLog[]
  exports          Export[]
  extractionJobs   ExtractionJob[]
  commitmentTerms  CommitmentTerm[]
  emailLogs        EmailLog[]
  reminderSchedules ReminderSchedule[]
  contacts          ProgramContact[]

  @@map("programs")
}

// ─── Baseline (Assumption Locker) ───────────────────────────

model Baseline {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId    String         @map("program_id") @db.Uuid
  version      Int            @default(1)
  title        String
  status       BaselineStatus @default(DRAFT)
  sourceFileId String?        @map("source_file_id") @db.Uuid
  releasedAt   DateTime?      @map("released_at")
  confirmedAt  DateTime?      @map("confirmed_at")
  lockedAt     DateTime?      @map("locked_at")
  supersededAt     DateTime?      @map("superseded_at")
  counterpartyNote String?        @map("counterparty_note")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  sourceFile      Evidence?        @relation("BaselineSource", fields: [sourceFileId], references: [id])
  clauses         BaselineClause[]
  changes         Change[]
  commitmentTerms CommitmentTerm[] @relation("TermBaseline")

  @@unique([programId, version])
  @@map("baselines")
}

model BaselineClause {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baselineId  String     @map("baseline_id") @db.Uuid
  clauseRef   String?    @map("clause_ref")
  type        ClauseType
  title       String
  description String?
  value       Decimal?   @db.Decimal(14, 2)
  unit        String?
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  baseline   Baseline    @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  lineItems  InvoiceLineItem[] @relation("ClauseLineItems")

  @@map("baseline_clauses")
}

// ─── Change Ledger ──────────────────────────────────────────

model Change {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId       String         @map("program_id") @db.Uuid
  baselineId      String?        @map("baseline_id") @db.Uuid
  sequenceNum     Int            @map("sequence_num")
  title           String
  description     String?
  severity        ChangeSeverity @default(MEDIUM)
  status          ChangeStatus   @default(DRAFT)
  estimatedImpact    Decimal?          @map("estimated_impact") @db.Decimal(14, 2)
  reasonCode         ChangeReasonCode? @map("reason_code")
  scheduleImpactDays Int?              @map("schedule_impact_days")
  confirmationMode   ConfirmationMode? @map("confirmation_mode")
  evidenceFileId     String?           @map("evidence_file_id") @db.Uuid
  releasedAt         DateTime?         @map("released_at")
  confirmedAt        DateTime?         @map("confirmed_at")
  counterpartyNote   String?           @map("counterparty_note")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  program      Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  baseline     Baseline? @relation(fields: [baselineId], references: [id])
  evidenceFile Evidence? @relation("ChangeEvidence", fields: [evidenceFileId], references: [id])
  lineItems    InvoiceLineItem[] @relation("ChangeLineItems")

  @@unique([programId, sequenceNum])
  @@map("changes")
}

// ─── Invoice Reconciliation ─────────────────────────────────

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId      String        @map("program_id") @db.Uuid
  invoiceNumber  String?       @map("invoice_number")
  vendorName     String?       @map("vendor_name")
  invoiceDate    DateTime?     @map("invoice_date")
  dueDate        DateTime?     @map("due_date")
  totalAmount    Decimal?      @map("total_amount") @db.Decimal(14, 2)
  currency       String        @default("USD")
  status         InvoiceStatus @default(UPLOADED)
  evidenceFileId String?       @map("evidence_file_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  program           Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  evidenceFile      Evidence?         @relation("InvoiceEvidence", fields: [evidenceFileId], references: [id])
  lineItems         InvoiceLineItem[]
  reminderSchedule  ReminderSchedule?

  @@map("invoices")
}

model InvoiceLineItem {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String       @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal?     @db.Decimal(14, 4)
  unitPrice   Decimal?     @map("unit_price") @db.Decimal(14, 2)
  amount      Decimal      @db.Decimal(14, 2)
  clauseId    String?      @map("clause_id") @db.Uuid
  changeId    String?      @map("change_id") @db.Uuid
  flag        LineItemFlag @default(NONE)
  flagNote    String?      @map("flag_note")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clause  BaselineClause? @relation("ClauseLineItems", fields: [clauseId], references: [id])
  change  Change?         @relation("ChangeLineItems", fields: [changeId], references: [id])

  @@map("invoice_line_items")
}

// ─── Evidence & Storage ─────────────────────────────────────

model Evidence {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId   String       @map("program_id") @db.Uuid
  type        EvidenceType
  fileName    String       @map("file_name")
  fileSize    Int          @map("file_size")
  mimeType    String       @map("mime_type")
  storagePath String       @map("storage_path")
  sha256Hash  String       @map("sha256_hash")
  metadata     Json?        @default("{}")
  originalDate DateTime?   @map("original_date")
  isBackloaded Boolean     @default(false) @map("is_backloaded")
  finalized    Boolean     @default(false)
  finalizedAt  DateTime?   @map("finalized_at")
  retainUntil DateTime?    @map("retain_until")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  program            Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  baselinesAsSource  Baseline[]       @relation("BaselineSource")
  changesAsEvidence  Change[]         @relation("ChangeEvidence")
  invoicesAsEvidence Invoice[]        @relation("InvoiceEvidence")
  extractionJobs     ExtractionJob[]
  termsAsEvidence    CommitmentTerm[] @relation("TermEvidence")

  @@map("evidences")
}

// ─── Append-Only Event Log ──────────────────────────────────

model EventLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId  String?     @map("program_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     EventAction
  entityType String?     @map("entity_type")
  entityId   String?     @map("entity_id") @db.Uuid
  metadata   Json?       @default("{}")
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  program Program? @relation(fields: [programId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([programId, createdAt])
  @@index([entityType, entityId])
  @@map("event_logs")
}

// ─── Magic Links ────────────────────────────────────────────

model MagicLink {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token       String         @unique @default(dbgenerated("gen_random_uuid()"))
  scope       MagicLinkScope
  entityId    String         @map("entity_id") @db.Uuid
  createdById String         @map("created_by_id") @db.Uuid
  emailLogId  String?        @map("email_log_id") @db.Uuid
  singleUse   Boolean        @default(false) @map("single_use")
  expiresAt   DateTime       @map("expires_at")
  viewedAt    DateTime?      @map("viewed_at")
  confirmedAt DateTime?      @map("confirmed_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  createdBy User      @relation("CreatedByUser", fields: [createdById], references: [id])
  emailLog  EmailLog? @relation(fields: [emailLogId], references: [id])

  @@index([token])
  @@map("magic_links")
}

// ─── Exports ────────────────────────────────────────────────

model Export {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId   String     @map("program_id") @db.Uuid
  type        ExportType
  fileName    String     @map("file_name")
  storagePath String     @map("storage_path")
  sha256Hash  String     @map("sha256_hash")
  metadata    Json?      @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("exports")
}

// ─── AI Extraction ─────────────────────────────────────────

model ExtractionJob {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId      String                @map("evidence_id") @db.Uuid
  programId       String                @map("program_id") @db.Uuid
  targetType      ExtractionTargetType  @map("target_type")
  status          ExtractionJobStatus   @default(PENDING)
  extractedData   Json?                 @map("extracted_data")
  errorMessage    String?               @map("error_message")
  confidence      Decimal?              @db.Decimal(3, 2)
  processingTimeMs Int?                 @map("processing_time_ms")
  tokensUsed      Int?                  @map("tokens_used")
  modelUsed       String?               @map("model_used")
  startedAt       DateTime?             @map("started_at")
  completedAt     DateTime?             @map("completed_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  program  Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
  @@index([programId, status])
  @@index([programId, createdAt])
  @@map("extraction_jobs")
}

// ─── Commitment Terms (Timeline) ──────────────────────────

model CommitmentTerm {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId      String    @map("program_id") @db.Uuid
  evidenceId     String?   @map("evidence_id") @db.Uuid
  baselineId     String?   @map("baseline_id") @db.Uuid
  termType       TermType  @map("term_type")
  label          String
  dateOrOffset   String?   @map("date_or_offset")
  deadlineAt     DateTime? @map("deadline_at")
  costOrPercent  String?   @map("cost_or_percent")
  conditions     String?
  excerpt        String?
  page           Int?
  confidence     Decimal?  @db.Decimal(3, 2)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  program  Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  evidence Evidence? @relation("TermEvidence", fields: [evidenceId], references: [id])
  baseline Baseline? @relation("TermBaseline", fields: [baselineId], references: [id])

  @@index([programId, deadlineAt])
  @@index([programId, termType])
  @@map("commitment_terms")
}

// ─── Import Mappings (CSV/Excel) ─────────────────────────

model ImportMapping {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String           @map("org_id") @db.Uuid
  name       String
  targetType ImportTargetType @map("target_type")
  columnMap  Json             @map("column_map")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("import_mappings")
}

// ─── Email Infrastructure ─────────────────────────────────

model EmailLog {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String            @map("org_id") @db.Uuid
  programId       String            @map("program_id") @db.Uuid
  senderUserId    String            @map("sender_user_id") @db.Uuid
  recipientEmail  String            @map("recipient_email")
  recipientName   String?           @map("recipient_name")
  subject         String
  templateType    EmailTemplateType @map("template_type")
  entityType      EmailEntityType?  @map("entity_type")
  entityId        String?           @map("entity_id") @db.Uuid
  status          EmailStatus       @default(QUEUED)
  resendId        String?           @map("resend_id")
  sentAt          DateTime?         @map("sent_at")
  deliveredAt     DateTime?         @map("delivered_at")
  openedAt        DateTime?         @map("opened_at")
  metadata        Json?             @default("{}")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  program    Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  sender     User         @relation("SentEmails", fields: [senderUserId], references: [id])
  magicLinks MagicLink[]

  @@index([programId, createdAt])
  @@index([entityType, entityId])
  @@index([resendId])
  @@map("email_logs")
}

model OrgEmailConfig {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @unique @map("org_id") @db.Uuid
  sendingDomain   String?  @map("sending_domain")
  domainVerified  Boolean  @default(false) @map("domain_verified")
  defaultReplyTo  String?  @map("default_reply_to")
  dkimConfigured  Boolean  @default(false) @map("dkim_configured")
  spfConfigured   Boolean  @default(false) @map("spf_configured")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("org_email_configs")
}

// ─── Payment Reminder Schedules ──────────────────────────

model ReminderSchedule {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  programId       String    @map("program_id") @db.Uuid
  invoiceId       String    @unique @map("invoice_id") @db.Uuid
  recipientEmail  String    @map("recipient_email")
  frequencyDays   Int       @default(14) @map("frequency_days")
  startOffsetDays Int       @default(-7) @map("start_offset_days")
  escalationTier  Int       @default(1) @map("escalation_tier")
  reminderCount   Int       @default(0) @map("reminder_count")
  isActive        Boolean   @default(true) @map("is_active")
  lastSentAt      DateTime? @map("last_sent_at")
  nextSendAt      DateTime? @map("next_send_at")
  pausedAt        DateTime? @map("paused_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  program Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([nextSendAt, isActive])
  @@map("reminder_schedules")
}

// ─── Program Contacts ───────────────────────────────────

model ProgramContact {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId        String      @map("program_id") @db.Uuid
  orgId            String      @map("org_id") @db.Uuid
  name             String
  email            String
  title            String?
  organizationName String?     @map("organization_name")
  contactType      ContactType @default(CLIENT) @map("contact_type")
  phone            String?
  isPrimary        Boolean     @default(false) @map("is_primary")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  program Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([programId, contactType])
  @@map("program_contacts")
}
