# React 19 + react-joyride@2.9.3 peer-dep mismatch — joyride is React-19-safe
# in practice, but its peerDependencies declare 15–18 only. Vercel's
# `npm install` defaults to strict peer resolution, which fails the build.
# Setting legacy-peer-deps replicates pre-npm-7 behaviour (warn-only) for
# this repo. Revisit when react-joyride publishes a release that lists
# React 19 in peerDependencies.
legacy-peer-deps=true
